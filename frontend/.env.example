# Copy to .env.local and fill in. Never commit .env.local.

# developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Set by `npm run webhook:register -- <public url>`
PAYPAL_WEBHOOK_ID=

# Sandbox BUSINESS accounts that receive the money, one per demo shop (Sandbox accounts → Create account → Business)
PAYEE_EMAIL_NORDIC_GEAR=
PAYEE_EMAIL_EU_SPORTDIRECT=
PAYEE_EMAIL_DEALZONE_X=

# Postgres connection string on Render. Leave empty locally: an embedded PGlite database in .data/ is used.
DATABASE_URL=

# Vault ID of the buyer wallet saved once (set by the spike or the PayPal link flow)
PAYPAL_VAULT_ID=

# AI. Without a key GUARDRAIL runs in clearly labelled offline test mode (deterministic, no LLM).
ANTHROPIC_API_KEY=
