# Copy to .env.local and fill in. Never commit .env.local.

# developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional for the spike: sandbox BUSINESS account (country NL) acting as the demo shop "nordic-gear"
PAYEE_EMAIL_NORDIC_GEAR=

# From day 3: Apps & Credentials → your app → Webhooks
PAYPAL_WEBHOOK_ID=
